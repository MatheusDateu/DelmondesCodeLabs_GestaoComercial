@page "/not-found"
@layout MainLayout
@inject IStringLocalizer<DelmondesCodeLabs_GestaoComercial.Resources.App> StrLocalizer

<MudContainer MaxWidth="MaxWidth.Medium" Class="d-flex flex-column align-center justify-center mt-16 pt-16">
    <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Color="Color.Error" Size="Size.Large" Style="font-size: 6rem;" />

    <MudText Typo="Typo.h3" Class="mt-4 mb-2" Align="Align.Center">
        @StrLocalizer["Page Not Found"]
    </MudText>

    <MudText Typo="Typo.body1" Align="Align.Center" Class="mb-6">
        @StrLocalizer["Sorry, mate! The content you are looking for does not exist or has been moved."]
    </MudText>

    <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large">
        @StrLocalizer["Return to Dashboard"]
    </MudButton>
</MudContainer>
@page "/Account/Manage/PersonalData"

@using Microsoft.AspNetCore.Identity
@using DelmondesCodeLabs_GestaoComercial.Data
@using Microsoft.Extensions.Localization

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager
@inject IStringLocalizer<DelmondesCodeLabs_GestaoComercial.Resources.App> StrLocalizer

<PageTitle>@StrLocalizer["Personal Data"] - Delmondes CodeLabs</PageTitle>

<MudCard Elevation="4" Class="pa-6" Style="border-top: 4px solid var(--mud-palette-primary); border-radius: 8px;">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h5" Style="font-weight: bold;">@StrLocalizer["Personal Data"]</MudText>
        </CardHeaderContent>
    </MudCardHeader>

    <MudCardContent>
        <StatusMessage />

        <MudText Typo="Typo.body1" Class="mb-4">
            @StrLocalizer["Your account contains personal data that you have given us. This page allows you to download or delete that data."]
        </MudText>

        <MudAlert Severity="Severity.Warning" Class="mb-6">
            <strong>@StrLocalizer["Warning"]:</strong> @StrLocalizer["Deleting this data will permanently remove your account, and this cannot be recovered."]
        </MudAlert>

        <MudGrid>
            <MudItem xs="12" sm="6">
                <!-- Native form for download action -->
                <form action="Account/Manage/DownloadPersonalData" method="post" data-enhance="false">
                    <AntiforgeryToken />
                    <button type="submit" class="mud-native-btn">
                        @StrLocalizer["Download Data"].ToString().ToUpper()
                    </button>
                </form>
            </MudItem>
            <MudItem xs="12" sm="6">
                <!-- Kept MudButton here as it operates purely as an Href redirect -->
                <MudButton Href="Account/Manage/DeletePersonalData" Variant="Variant.Filled" Color="Color.Error" FullWidth="true" Style="font-weight: bold;">
                    @StrLocalizer["Delete Account"].ToString().ToUpper()
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudCardContent>
</MudCard>

@code {
    #region Properties
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;
    #endregion

    #region Lifecycle
    protected override async Task OnInitializedAsync()
    {
        ApplicationUser? user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
        }
    }
    #endregion

}
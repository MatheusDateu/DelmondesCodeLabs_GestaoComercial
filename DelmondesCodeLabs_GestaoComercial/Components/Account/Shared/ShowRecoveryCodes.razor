@using Microsoft.Extensions.Localization
@inject IStringLocalizer<DelmondesCodeLabs_GestaoComercial.Resources.App> StrLocalizer

<StatusMessage Message="@StatusMessage" />

<MudText Typo="Typo.h5" Style="font-weight: bold;" Class="mb-4">@StrLocalizer["Recovery Codes"]</MudText>

<MudAlert Severity="Severity.Warning" Class="mb-6">
    <strong>@StrLocalizer["Put these codes in a safe place."]</strong><br /><br />
    @StrLocalizer["If you lose your device and don't have the recovery codes, you will lose access to your account."]
</MudAlert>

<MudGrid>
    @foreach (var recoveryCode in RecoveryCodes)
    {
        <MudItem xs="12" sm="6" md="4">
            <MudPaper Elevation="0" Class="pa-3 text-center" Style="background-color: #1e1e2d; border: 1px solid #333; border-radius: 4px;">
                <MudText Typo="Typo.body1" Style="font-family: monospace; font-weight: bold; letter-spacing: 2px; color: #03fa6e;">
                    @recoveryCode
                </MudText>
            </MudPaper>
        </MudItem>
    }
</MudGrid>

@code {
    #region Properties
    [Parameter]
    public string[] RecoveryCodes { get; set; } = [];

    [Parameter]
    public string? StatusMessage { get; set; }
    #endregion Properties

}
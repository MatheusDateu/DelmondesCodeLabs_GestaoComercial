@page "/Account/ResetPasswordConfirmation"

@using Microsoft.Extensions.Localization
@inject IStringLocalizer<DelmondesCodeLabs_GestaoComercial.Resources.App> StrLocalizer

<PageTitle>@StrLocalizer["Reset Password Confirmation"] - Delmondes CodeLabs</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-16 pt-16">
    <MudCard Elevation="4" Class="pa-6" Style="border-top: 4px solid var(--mud-palette-primary); border-radius: 8px;">
        <MudCardContent Class="d-flex flex-column align-center">
            <MudIcon Icon="@Icons.Material.Filled.Password" Color="Color.Primary" Style="font-size: 5rem;" />
            <MudText Typo="Typo.h5" Class="mt-4" Style="font-weight: bold;">
                @StrLocalizer["Password Reset Complete"]
            </MudText>

            <MudText Typo="Typo.body1" Align="Align.Center" Class="mt-2 text-muted">
                @StrLocalizer["Your password has been successfully reset."]
            </MudText>

            <MudButton Href="/Account/Login" Variant="Variant.Filled" Color="Color.Primary" Class="mt-6" Style="font-weight: bold; color: #000000;">
                @StrLocalizer["Proceed to Login"].ToString().ToUpper()
            </MudButton>
        </MudCardContent>
    </MudCard>
</MudContainer>
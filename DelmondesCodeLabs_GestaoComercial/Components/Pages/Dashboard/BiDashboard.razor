@page "/bi"
@attribute [Authorize(Roles = "SuperUser, Admin")]

@using DelmondesCodeLabs_GestaoComercial.Domain.DTOs
@using DelmondesCodeLabs_GestaoComercial.Domain.Interfaces
@using Microsoft.Extensions.Localization

@inject IBIDashboardQueries BiDashboardQueries
@inject IStringLocalizer<DelmondesCodeLabs_GestaoComercial.Resources.App> StrLocalizer

<PageTitle>@StrLocalizer["BI Dashboard"] - Delmondes CodeLabs</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 px-2 px-sm-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-6 px-2 flex-wrap">
        <MudText Typo="Typo.h4" Color="Color.Primary" Style="font-weight: bold;">
            @StrLocalizer["BI Dashboard"]
        </MudText>
    </MudStack>

    <MudPaper Elevation="4" Class="pa-4 mb-6" Style="border-top: 4px solid var(--mud-palette-primary); border-radius: 8px;">
        <MudGrid Spacing="2" AlignItems="AlignItems.End">
            <MudItem xs="12" sm="4" md="3">
                <MudDatePicker Label="@StrLocalizer["Start Date"]" @bind-Date="_startDate" Variant="Variant.Outlined" Required="true" />
            </MudItem>
            <MudItem xs="12" sm="4" md="3">
                <MudDatePicker Label="@StrLocalizer["End Date"]" @bind-Date="_endDate" Variant="Variant.Outlined" Required="true" />
            </MudItem>
            <MudItem xs="12" sm="4" md="2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadDashboardDataAsync" Style="color: #000000; font-weight: bold;" FullWidth="true">
                    @StrLocalizer["Filter"].ToString().ToUpper()
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @if (_isLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
    }
    else if (_financialSummary != null)
    {
        <MudGrid Spacing="3" Class="mb-6">
            <MudItem xs="12" sm="6" md="4" lg="2">
                <MudCard Elevation="2" Style="border-left: 4px solid var(--mud-palette-info);">
                    <MudCardContent>
                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">@StrLocalizer["Gross Revenue"]</MudText>
                        <MudText Typo="Typo.h5" Style="font-weight: bold;">@_financialSummary.GrossRevenue.ToString("C")</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="4" lg="2">
                <MudCard Elevation="2" Style="border-left: 4px solid var(--mud-palette-warning);">
                    <MudCardContent>
                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">@StrLocalizer["Discounts"]</MudText>
                        <MudText Typo="Typo.h5" Style="font-weight: bold;">@_financialSummary.TotalDiscounts.ToString("C")</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="4" lg="2">
                <MudCard Elevation="2" Style="border-left: 4px solid var(--mud-palette-secondary);">
                    <MudCardContent>
                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">@StrLocalizer["COGS"]</MudText>
                        <MudText Typo="Typo.h5" Style="font-weight: bold;">@_financialSummary.CostOfGoodsSold.ToString("C")</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="4" lg="2">
                <MudCard Elevation="2" Style="border-left: 4px solid var(--mud-palette-error);">
                    <MudCardContent>
                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">@StrLocalizer["Payed Expenses"]</MudText>
                        <MudText Typo="Typo.h5" Style="font-weight: bold;">@_financialSummary.TotalExpenses.ToString("C")</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="4" lg="2">
                <MudCard Elevation="2" Style="border-left: 4px solid var(--mud-palette-error);">
                    <MudCardContent>
                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">@StrLocalizer["Losses"]</MudText>
                        <MudText Typo="Typo.h5" Style="font-weight: bold;">@_financialSummary.TotalLosses.ToString("C")</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="4" lg="2">
                <MudCard Elevation="2" Style="@GetNetProfitCardStyle()">
                    <MudCardContent>
                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">@StrLocalizer["Net Profit"]</MudText>
                        <MudText Typo="Typo.h5" Color="@(_financialSummary.NetProfit >= 0 ? Color.Success : Color.Error)" Style="font-weight: bold;">@_financialSummary.NetProfit.ToString("C")</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>

        <MudGrid Spacing="3">
            <!-- Colorful Bar Chart -->
            <MudItem xs="12" md="6">
                <MudPaper Elevation="4" Class="pa-6 h-100" Style="border-radius: 8px;">
                    <MudText Typo="Typo.h6" Class="mb-6" Style="font-weight: bold; text-align: center;">@StrLocalizer["ABC Curve - Revenue Share"]</MudText>
                    @if (_chartSeries.Any())
                    {
                        <MudChart T="double" ChartType="ChartType.Bar" ChartSeries="@_chartSeries" Width="100%" Height="350px" />
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Text">@StrLocalizer["No data available for the selected period."]</MudAlert>
                    }
                </MudPaper>
            </MudItem>

            <!-- Detailed Table -->
            <MudItem xs="12" md="6">
                <MudPaper Elevation="4" Class="pa-4 h-100" Style="border-radius: 8px; overflow-y: auto; max-height: 450px;">
                    <MudText Typo="Typo.h6" Class="mb-4" Style="font-weight: bold;">@StrLocalizer["Top 10 Products"]</MudText>
                    <MudTable T="AbcProductDto" Items="@_abcProducts" Dense="true" Hover="true" Elevation="0">
                        <HeaderContent>
                            <MudTh>@StrLocalizer["Product"]</MudTh>
                            <MudTh Style="text-align: right">@StrLocalizer["Qty Sold"]</MudTh>
                            <MudTh Style="text-align: right">@StrLocalizer["Revenue"]</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="product">
                            <MudTd DataLabel="@StrLocalizer["Product"]" Style="font-weight: bold;">@product.ProductName</MudTd>
                            <MudTd DataLabel="@StrLocalizer["Qty Sold"]" Style="text-align: right">@product.TotalQuantitySold.ToString("N0")</MudTd>
                            <MudTd DataLabel="@StrLocalizer["Revenue"]" Style="text-align: right; color: var(--mud-palette-success); font-weight: bold;">@product.TotalRevenue.ToString("C")</MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    #region Fields
    private DateTime? _startDate;
    private DateTime? _endDate;
    private bool _isLoading = false;
    private FinancialSummaryDto? _financialSummary;
    private IEnumerable<AbcProductDto> _abcProducts = new List<AbcProductDto>();

    private List<ChartSeries<double>> _chartSeries = new();
    #endregion Fields

    #region Lifecycle
    protected override async Task OnInitializedAsync()
    {
        DateTime nowUtc = DateTime.UtcNow;
        DateTime localNow = nowUtc.AddHours(-4);

        _startDate = new DateTime(localNow.Year, localNow.Month, 1, 0, 0, 0, DateTimeKind.Unspecified);
        _endDate = new DateTime(localNow.Year, localNow.Month, localNow.Day, 0, 0, 0, DateTimeKind.Unspecified);

        await LoadDashboardDataAsync();
    }
    #endregion Lifecycle

    #region Methods
    private async Task LoadDashboardDataAsync()
    {
        if (_startDate == null || _endDate == null) return;

        _isLoading = true;

        DateTime cleanStartDate = DateTime.SpecifyKind(_startDate.Value, DateTimeKind.Unspecified);
        DateTime cleanEndDate = DateTime.SpecifyKind(_endDate.Value.AddDays(1).AddTicks(-1), DateTimeKind.Unspecified);

        DateTimeOffset startOffset = new DateTimeOffset(cleanStartDate, TimeSpan.FromHours(-4));
        DateTimeOffset endOffset = new DateTimeOffset(cleanEndDate, TimeSpan.FromHours(-4));

        _financialSummary = await BiDashboardQueries.GetFinancialSummaryAsync(startOffset, endOffset);
        _abcProducts = await BiDashboardQueries.GetAbcSalesCurveAsync(startOffset, endOffset);

        UpdateChartData();

        _isLoading = false;
    }

    private void UpdateChartData()
    {
        if (_abcProducts == null || !_abcProducts.Any())
        {
            _chartSeries.Clear();
            return;
        }

        // Mapeia cada produto para uma série diferente. A legenda fará o trabalho de mostrar os nomes.
        _chartSeries = _abcProducts.Select(p => new ChartSeries<double>
        {
            Name = p.ProductName.Length > 15 ? p.ProductName.Substring(0, 15) + "..." : p.ProductName,
            Data = new double[] { Convert.ToDouble(p.TotalRevenue) }
        }).ToList();
    }

    private string GetNetProfitCardStyle()
    {
        if (_financialSummary == null) return string.Empty;

        return _financialSummary.NetProfit >= 0
            ? "border-left: 4px solid var(--mud-palette-success); background-color: rgba(3, 250, 110, 0.05);"
            : "border-left: 4px solid var(--mud-palette-error); background-color: rgba(244, 67, 54, 0.05);";
    }
    #endregion Methods

}
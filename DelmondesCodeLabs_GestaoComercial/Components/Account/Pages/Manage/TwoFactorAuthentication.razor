@page "/Account/Manage/TwoFactorAuthentication"

@using Microsoft.AspNetCore.Http.Features
@using Microsoft.AspNetCore.Identity
@using DelmondesCodeLabs_GestaoComercial.Data
@using Microsoft.Extensions.Localization

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager
@inject IStringLocalizer<DelmondesCodeLabs_GestaoComercial.Resources.App> StrLocalizer

<PageTitle>@StrLocalizer["Two-Factor Authentication (2FA)"] - Delmondes CodeLabs</PageTitle>

<MudCard Elevation="4" Class="pa-6" Style="border-top: 4px solid var(--mud-palette-primary); border-radius: 8px;">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h5" Style="font-weight: bold;">@StrLocalizer["Two-Factor Authentication (2FA)"]</MudText>
        </CardHeaderContent>
    </MudCardHeader>

    <MudCardContent>
        <StatusMessage />

        @if (canTrack)
        {
            if (is2faEnabled)
            {
                if (recoveryCodesLeft == 0)
                {
                    <MudAlert Severity="Severity.Error" Class="mb-4">
                        <strong>@StrLocalizer["You have no recovery codes left."]</strong>
                        <br />@StrLocalizer["You must"] <MudLink Href="Account/Manage/GenerateRecoveryCodes" Underline="Underline.Always">@StrLocalizer["generate a new set of recovery codes"]</MudLink> @StrLocalizer["before you can log in with a recovery code."]
                    </MudAlert>
                }
                else if (recoveryCodesLeft == 1)
                {
                    <MudAlert Severity="Severity.Error" Class="mb-4">
                        <strong>@StrLocalizer["You have 1 recovery code left."]</strong>
                        <br />@StrLocalizer["You can"] <MudLink Href="Account/Manage/GenerateRecoveryCodes" Underline="Underline.Always">@StrLocalizer["generate a new set of recovery codes"]</MudLink>.
                    </MudAlert>
                }
                else if (recoveryCodesLeft <= 3)
                {
                    <MudAlert Severity="Severity.Warning" Class="mb-4">
                        <strong>@string.Format(StrLocalizer["You have {0} recovery codes left."].Value, recoveryCodesLeft)</strong>
                        <br />@StrLocalizer["You should"] <MudLink Href="Account/Manage/GenerateRecoveryCodes" Underline="Underline.Always">@StrLocalizer["generate a new set of recovery codes"]</MudLink>.
                    </MudAlert>
                }

                <MudGrid Class="mb-6">
                    @if (isMachineRemembered)
                    {
                        <MudItem>
                            <form style="display: inline-block" @formname="forget-browser" @onsubmit="OnSubmitForgetBrowserAsync" method="post">
                                <button type="submit" class="mud-native-btn" style="padding: 6px 16px; background-color: transparent; border: 1px solid var(--mud-palette-lines-default); color: var(--mud-palette-text-primary);">
                                    @StrLocalizer["Forget this browser"].ToString().ToUpper()
                                </button>
                            </form>
                        </MudItem>
                    }
                    <MudItem>
                        <MudButton Href="Account/Manage/Disable2fa" Variant="Variant.Filled" Color="Color.Error">
                            @StrLocalizer["Disable 2FA"]
                        </MudButton>
                    </MudItem>
                    <MudItem>
                        <MudButton Href="Account/Manage/GenerateRecoveryCodes" Variant="Variant.Filled" Color="Color.Primary" Style="color: #000000;">
                            @StrLocalizer["Reset recovery codes"]
                        </MudButton>
                    </MudItem>
                </MudGrid>
            }

            <MudText Typo="Typo.h6" Class="mt-6 mb-3" Style="font-weight: bold;">@StrLocalizer["Authenticator App"]</MudText>

            <MudGrid>
                @if (!hasAuthenticator)
                {
                    <MudItem>
                        <MudButton Href="Account/Manage/EnableAuthenticator" Variant="Variant.Filled" Color="Color.Primary" Style="color: #000000; font-weight: bold;">
                            @StrLocalizer["Add authenticator app"].ToString().ToUpper()
                        </MudButton>
                    </MudItem>
                }
                else
                {
                    <MudItem>
                        <MudButton Href="Account/Manage/EnableAuthenticator" Variant="Variant.Filled" Color="Color.Primary" Style="color: #000000; font-weight: bold;">
                            @StrLocalizer["Set up authenticator app"].ToString().ToUpper()
                        </MudButton>
                    </MudItem>
                    <MudItem>
                        <MudButton Href="Account/Manage/ResetAuthenticator" Variant="Variant.Outlined" Color="Color.Error">
                            @StrLocalizer["Reset authenticator app"]
                        </MudButton>
                    </MudItem>
                }
            </MudGrid>
        }
        else
        {
            <MudAlert Severity="Severity.Error">
                <strong>@StrLocalizer["Privacy and cookie policy have not been accepted."]</strong>
                <br />@StrLocalizer["You must accept the policy before you can enable two factor authentication."]
            </MudAlert>
        }
    </MudCardContent>
</MudCard>

@code {
    #region Fields
    private bool canTrack;
    private bool hasAuthenticator;
    private int recoveryCodesLeft;
    private bool is2faEnabled;
    private bool isMachineRemembered;
    #endregion

    #region Properties
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;
    #endregion

    #region Lifecycle
    protected override async Task OnInitializedAsync()
    {
        ApplicationUser? user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        canTrack = HttpContext.Features.Get<ITrackingConsentFeature>()?.CanTrack ?? true;
        hasAuthenticator = await UserManager.GetAuthenticatorKeyAsync(user) is not null;
        is2faEnabled = await UserManager.GetTwoFactorEnabledAsync(user);
        isMachineRemembered = await SignInManager.IsTwoFactorClientRememberedAsync(user);
        recoveryCodesLeft = await UserManager.CountRecoveryCodesAsync(user);
    }
    #endregion

    #region Methods
    private async Task OnSubmitForgetBrowserAsync()
    {
        await SignInManager.ForgetTwoFactorClientAsync();

        RedirectManager.RedirectToCurrentPageWithStatus(
            StrLocalizer["The current browser has been forgotten. When you login again from this browser you will be prompted for your 2fa code."],
            HttpContext);
    }
    #endregion

}
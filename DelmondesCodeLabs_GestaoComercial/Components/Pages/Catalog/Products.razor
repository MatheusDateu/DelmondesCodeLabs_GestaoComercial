@page "/catalog/products"
@attribute [Authorize(Roles = "SuperUser, Admin")]

@using DelmondesCodeLabs_GestaoComercial.Domain.Entities
@using DelmondesCodeLabs_GestaoComercial.Domain.Interfaces
@using DelmondesCodeLabs_GestaoComercial.Domain.Common

@inject IProductQueries ProductQueries
@inject IProductRepository ProductRepository
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStringLocalizer<DelmondesCodeLabs_GestaoComercial.Resources.App> StrLocalizer

<PageTitle>@StrLocalizer["Products"] - Delmondes CodeLabs</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 px-2 px-sm-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-6 px-2 flex-wrap">
        <MudText Typo="Typo.h4" Color="Color.Primary" Style="font-weight: bold;">
            @StrLocalizer["Products"]
        </MudText>

        <MudSpacer />

        @if (_selectedItems?.Any() == true)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="DeleteSelectedProductsAsync" StartIcon="@Icons.Material.Filled.DeleteSweep" Style="font-weight: bold;">
                @StrLocalizer["Delete"].ToString().ToUpper() (@_selectedItems.Count)
            </MudButton>
        }

        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenCreateDialogAsync" Style="color: #000000; font-weight: bold;" StartIcon="@Icons.Material.Filled.Add">
            @StrLocalizer["New Product"].ToString().ToUpper()
        </MudButton>
    </MudStack>

    <MudTable ServerData="LoadServerDataAsync" MultiSelection="true" @bind-SelectedItems="_selectedItems" Dense="true" Hover="true" @ref="_table" Elevation="4" Style="border-top: 4px solid #03fa6e; border-radius: 8px;" Breakpoint="Breakpoint.Sm" HorizontalScrollbar="true">
        <ToolBarContent>
            <MudSpacer />
            <MudTextField T="string" MaxLength="100" ValueChanged="@(s => OnSearchAsync(s))" Placeholder="@StrLocalizer["Search products..."]" Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" />
        </ToolBarContent>

        <HeaderContent>
            <MudTh>@StrLocalizer["SKU"]</MudTh>
            <MudTh>@StrLocalizer["Name"]</MudTh>
            <MudTh>@StrLocalizer["Type"]</MudTh>
            <MudTh>@StrLocalizer["Price"]</MudTh>
            <MudTh>@StrLocalizer["Stock"]</MudTh>
            <MudTh Style="text-align: right">@StrLocalizer["Actions"]</MudTh>
        </HeaderContent>

        <RowTemplate Context="product">
            <MudTd DataLabel="@StrLocalizer["SKU"]">@product.Sku</MudTd>
            <MudTd DataLabel="@StrLocalizer["Name"]" Style="font-weight: bold;">@product.Name</MudTd>
            <MudTd DataLabel="@StrLocalizer["Type"]">
                <MudChip T="string" Size="Size.Small" Color="@GetProductTypeColor(product.Type)" Variant="Variant.Filled">
                    @StrLocalizer[product.Type.ToString()]
                </MudChip>
            </MudTd>
            <MudTd DataLabel="@StrLocalizer["Price"]">@product.SellingPrice.ToString("C")</MudTd>
            <MudTd DataLabel="@StrLocalizer["Stock"]">
                <MudText Color="@(product.CurrentStock <= product.MinimumStockAlert ? Color.Error : Color.Default)" Style="@(product.CurrentStock <= product.MinimumStockAlert ? "font-weight: bold;" : "")">
                    @product.CurrentStock.ToString("N3")
                </MudText>
            </MudTd>
            <MudTd DataLabel="@StrLocalizer["Actions"]" Style="text-align: right">
                @if (product.Type == ProductType.Service || product.Type == ProductType.Standard)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.AccountTree" Color="Color.Info" Size="Size.Small" OnClick="@(() => OpenCompositionDialogAsync(product))" title="@StrLocalizer["Composition"]" />
                }
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => OpenEditDialogAsync(product))" title="@StrLocalizer["Edit"]" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteProductAsync(product))" title="@StrLocalizer["Delete"]" />
            </MudTd>
        </RowTemplate>

        <NoRecordsContent>
            <MudText>@StrLocalizer["No products found matching your search."]</MudText>
        </NoRecordsContent>

        <LoadingContent>
            <MudText>@StrLocalizer["Loading catalog..."]</MudText>
        </LoadingContent>

        <PagerContent>
            <MudTablePager RowsPerPageString="@StrLocalizer["Rows per page:"]"
                           InfoFormat="@StrLocalizer["{first_item}-{last_item} of {all_items}"]"
                           AllItemsText="@StrLocalizer["All"]" />
        </PagerContent>
    </MudTable>
</MudContainer>

@code {
    #region Fields
    private MudTable<Product> _table = default!;
    private string? _searchString;
    private HashSet<Product> _selectedItems = new();
    #endregion Fields

    #region Methods
    /// <summary>
    /// Executes the server-side pagination and full-text search against the Dapper queries infrastructure.
    /// </summary>
    private async Task<TableData<Product>> LoadServerDataAsync(TableState state, CancellationToken cancellationToken)
    {
        int page = state.Page + 1;
        int pageSize = state.PageSize;

        PagedResult<Product> result = await ProductQueries.SearchProductsAsync(_searchString, page, pageSize, cancellationToken);

        return new TableData<Product>()
        {
            TotalItems = result.TotalCount,
            Items = result.Items
        };
    }

    /// <summary>
    /// Triggers a table reload when the user types in the search bar or clears it.
    /// </summary>
    private async Task OnSearchAsync(string text)
    {
        _searchString = string.IsNullOrWhiteSpace(text) ? null : text;
        await _table.ReloadServerData();
    }

    /// <summary>
    /// Returns the appropriate theme colour based on the product type to improve visual contrast.
    /// </summary>
    private Color GetProductTypeColor(ProductType type)
    {
        return type switch
        {
            ProductType.Standard => Color.Info,
            ProductType.Service => Color.Secondary,
            ProductType.Component => Color.Dark,
            _ => Color.Default
        };
    }

    /// <summary>
    /// Instantiates and displays the product dialogue for creating a new record.
    /// </summary>
    private async Task OpenCreateDialogAsync()
    {
        DialogOptions options = new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Small };
        DialogParameters parameters = new DialogParameters
        {
            { "IsEditing", false },
            { "Model", new Product() }
        };

        IDialogReference dialog = await DialogService.ShowAsync<ProductDialog>(@StrLocalizer["New Product"], parameters, options);
        DialogResult result = await dialog.Result;

        if (!result.Canceled)
        {
            await _table.ReloadServerData();
        }
    }

    /// <summary>
    /// Instantiates and displays the product composition dialogue.
    /// </summary>
    private async Task OpenCompositionDialogAsync(Product product)
    {
        DialogOptions options = new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Medium };
        DialogParameters parameters = new DialogParameters
        {
            { "ParentProduct", product }
        };

        await DialogService.ShowAsync<ProductCompositionDialog>($"{StrLocalizer["Composition"]}: {product.Name}", parameters, options);
    }

    /// <summary>
    /// Instantiates and displays the product dialogue populated with an existing record for editing.
    /// </summary>
    private async Task OpenEditDialogAsync(Product product)
    {
        DialogOptions options = new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Small };
        DialogParameters parameters = new DialogParameters
        {
            { "IsEditing", true },
            { "Model", product }
        };

        IDialogReference dialog = await DialogService.ShowAsync<ProductDialog>(@StrLocalizer["Edit Product"], parameters, options);
        DialogResult result = await dialog.Result;

        if (!result.Canceled)
        {
            await _table.ReloadServerData();
        }
    }

    /// <summary>
    /// Prompts the user for confirmation and soft-deletes the specified product record.
    /// </summary>
    private async Task DeleteProductAsync(Product product)
    {
        bool? confirm = await DialogService.ShowMessageBoxAsync(
            @StrLocalizer["Delete Product"],
            $"{@StrLocalizer["Are you sure you want to delete the product"]} '{product.Name}'?",
            yesText: @StrLocalizer["Delete"].ToString().ToUpper(),
            cancelText: @StrLocalizer["Cancel"].ToString().ToUpper());

        if (confirm == true)
        {
            await ProductRepository.DeleteAsync(product);
            _selectedItems.Remove(product);
            Snackbar.Add(@StrLocalizer["Product deleted successfully."], Severity.Success);
            await _table.ReloadServerData();
        }
    }

    /// <summary>
    /// Prompts the user for confirmation and bulk soft-deletes all selected products.
    /// </summary>
    private async Task DeleteSelectedProductsAsync()
    {
        bool? confirm = await DialogService.ShowMessageBoxAsync(
            @StrLocalizer["Bulk Delete"],
            $"{@StrLocalizer["Are you sure you want to delete the selected products"]} {_selectedItems.Count}?",
            yesText: @StrLocalizer["Delete All"].ToString().ToUpper(),
            cancelText: @StrLocalizer["Cancel"].ToString().ToUpper());

        if (confirm == true)
        {
            foreach (Product product in _selectedItems)
            {
                await ProductRepository.DeleteAsync(product);
            }

            _selectedItems.Clear();
            Snackbar.Add(@StrLocalizer["Selected products deleted successfully."], Severity.Success);
            await _table.ReloadServerData();
        }
    }
    #endregion Methods

}
@page "/Account/Manage/Disable2fa"

@using Microsoft.AspNetCore.Identity
@using DelmondesCodeLabs_GestaoComercial.Data
@using Microsoft.Extensions.Localization

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<Disable2fa> Logger
@inject IStringLocalizer<DelmondesCodeLabs_GestaoComercial.Resources.App> StrLocalizer

<PageTitle>@StrLocalizer["Disable 2FA"] - Delmondes CodeLabs</PageTitle>

<MudCard Elevation="4" Class="pa-6" Style="border-top: 4px solid var(--mud-palette-error); border-radius: 8px;">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h5" Color="Color.Error" Style="font-weight: bold;">@StrLocalizer["Disable Two-Factor Authentication"]</MudText>
        </CardHeaderContent>
    </MudCardHeader>

    <MudCardContent>
        <StatusMessage />

        <MudAlert Severity="Severity.Warning" Class="mb-6">
            <strong>@StrLocalizer["This action only disables 2FA."]</strong><br /><br />
            @StrLocalizer["Disabling 2FA does not change the keys used in authenticator apps. If you wish to change the key used in an authenticator app, you should"] <MudLink Href="Account/Manage/ResetAuthenticator" Underline="Underline.Always">@StrLocalizer["reset your authenticator keys."]</MudLink>
        </MudAlert>

        <form @formname="disable-2fa" @onsubmit="OnSubmitAsync" method="post">
            <button type="submit" class="mud-native-btn" style="background-color: var(--mud-palette-error); color: #ffffff;">
                @StrLocalizer["Disable 2FA"].ToString().ToUpper()
            </button>
        </form>
    </MudCardContent>
</MudCard>

@code {
    #region Fields
    private ApplicationUser? user;
    #endregion Fields

    #region Properties
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;
    #endregion Properties

    #region Lifecycle
    protected override async Task OnInitializedAsync()
    {
        user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        if (HttpMethods.IsGet(HttpContext.Request.Method) && !await UserManager.GetTwoFactorEnabledAsync(user))
        {
            throw new InvalidOperationException("Cannot disable 2FA for user as it's not currently enabled.");
        }
    }
    #endregion Lifecycle

    #region Methods
    private async Task OnSubmitAsync()
    {
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        IdentityResult disable2faResult = await UserManager.SetTwoFactorEnabledAsync(user, false);
        if (!disable2faResult.Succeeded)
        {
            throw new InvalidOperationException("Unexpected error occurred disabling 2FA.");
        }

        string userId = await UserManager.GetUserIdAsync(user);
        Logger.LogInformation("User with ID '{UserId}' has disabled 2fa.", userId);

        RedirectManager.RedirectToWithStatus(
                    "Account/Manage/TwoFactorAuthentication",
                    StrLocalizer["2FA has been disabled. You can reenable 2FA when you setup an authenticator app."],
                    HttpContext);
    }
    #endregion Methods

}
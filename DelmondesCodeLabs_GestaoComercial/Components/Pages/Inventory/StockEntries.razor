@page "/inventory/entries"
@attribute [Authorize(Roles = "SuperUser, Admin")]

@using DelmondesCodeLabs_GestaoComercial.Domain.Entities
@using DelmondesCodeLabs_GestaoComercial.Domain.Interfaces
@using DelmondesCodeLabs_GestaoComercial.Domain.Common

@inject IStockEntryQueries StockEntryQueries
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStringLocalizer<DelmondesCodeLabs_GestaoComercial.Resources.App> StrLocalizer

<PageTitle>@StrLocalizer["Stock Entries"] - Delmondes CodeLabs</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 px-2 px-sm-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-6 px-2 flex-wrap">
        <MudText Typo="Typo.h4" Color="Color.Primary" Style="font-weight: bold;">
            @StrLocalizer["Stock Entries"]
        </MudText>

        <MudSpacer />

        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenCreateDialogAsync" Style="color: #000000; font-weight: bold;" StartIcon="@Icons.Material.Filled.Add">
            @StrLocalizer["New Stock Entry"].ToString().ToUpper()
        </MudButton>
    </MudStack>

    <MudTable ServerData="LoadServerDataAsync" Dense="true" Hover="true" @ref="_table" Elevation="4" Style="border-top: 4px solid #03fa6e; border-radius: 8px;" Breakpoint="Breakpoint.Sm" HorizontalScrollbar="true">
        <ToolBarContent>
            <MudSpacer />
            <MudTextField T="string" MaxLength="100" ValueChanged="@(s => OnSearchAsync(s))" Placeholder="@StrLocalizer["Search entries..."]" Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" />
        </ToolBarContent>

        <HeaderContent>
            <MudTh>@StrLocalizer["Invoice Number"]</MudTh>
            <MudTh>@StrLocalizer["Supplier"]</MudTh>
            <MudTh>@StrLocalizer["Date"]</MudTh>
            <MudTh>@StrLocalizer["Total"]</MudTh>
            <MudTh Style="text-align: right">@StrLocalizer["Actions"]</MudTh>
        </HeaderContent>

        <RowTemplate Context="entry">
            <MudTd DataLabel="@StrLocalizer["Invoice Number"]" Style="font-weight: bold;">@entry.InvoiceNumber</MudTd>
            <MudTd DataLabel="@StrLocalizer["Supplier"]">@entry.Supplier?.Name</MudTd>
            <MudTd DataLabel="@StrLocalizer["Date"]">@entry.EntryDate.ToString("dd/MM/yyyy")</MudTd>
            <MudTd DataLabel="@StrLocalizer["Total"]">@entry.TotalCost.ToString("C")</MudTd>
            <MudTd DataLabel="@StrLocalizer["Actions"]" Style="text-align: right">
                <MudIconButton Icon="@Icons.Material.Filled.Visibility" Color="Color.Primary" Size="Size.Small" OnClick="@(() => OpenViewDialogAsync(entry))" />
            </MudTd>
        </RowTemplate>

        <NoRecordsContent>
            <MudText>@StrLocalizer["No stock entries found matching your search."]</MudText>
        </NoRecordsContent>

        <LoadingContent>
            <MudText>@StrLocalizer["Loading..."]</MudText>
        </LoadingContent>

        <PagerContent>
            <MudTablePager RowsPerPageString="@StrLocalizer["Rows per page:"]"
                           InfoFormat="@StrLocalizer["{first_item}-{last_item} of {all_items}"]"
                           AllItemsText="@StrLocalizer["All"]" />
        </PagerContent>
    </MudTable>
</MudContainer>

@code {
    #region Fields
    private MudTable<StockEntry> _table = default!;
    private string? _searchString;
    #endregion Fields

    #region Methods
    /// <summary>
    /// Executes the server-side pagination and full-text search against the Dapper queries infrastructure.
    /// </summary>
    private async Task<TableData<StockEntry>> LoadServerDataAsync(TableState state, CancellationToken cancellationToken)
    {
        int page = state.Page + 1;
        int pageSize = state.PageSize;

        PagedResult<StockEntry> result = await StockEntryQueries.GetPaginatedAsync(_searchString, page, pageSize, cancellationToken);

        return new TableData<StockEntry>()
        {
            TotalItems = result.TotalCount,
            Items = result.Items
        };
    }

    /// <summary>
    /// Triggers a table reload when the user types in the search bar.
    /// </summary>
    private async Task OnSearchAsync(string text)
    {
        _searchString = string.IsNullOrWhiteSpace(text) ? null : text;
        await _table.ReloadServerData();
    }

    /// <summary>
    /// Instantiates and displays the stock entry dialogue for creating a new record.
    /// </summary>
    private async Task OpenCreateDialogAsync()
    {
        DialogOptions options = new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Medium };
        DialogParameters parameters = new DialogParameters
        {
            { "IsEditing", false },
            { "Model", new StockEntry() }
        };

        IDialogReference dialog = await DialogService.ShowAsync<StockEntryDialog>(StrLocalizer["New Stock Entry"], parameters, options);
        DialogResult result = await dialog.Result;

        if (!result.Canceled)
        {
            await _table.ReloadServerData();
        }
    }

    /// <summary>
    /// Opens the dialogue in read-only mode to view the invoice details.
    /// </summary>
    private async Task OpenViewDialogAsync(StockEntry entry)
    {
        StockEntry? fullEntry = await StockEntryQueries.GetByIdAsync(entry.Id);

        if (fullEntry != null)
        {
            DialogOptions options = new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Medium };
            DialogParameters parameters = new DialogParameters
            {
                { "IsEditing", true },
                { "Model", fullEntry }
            };

            await DialogService.ShowAsync<StockEntryDialog>($"{StrLocalizer["Invoice Number"]}: {fullEntry.InvoiceNumber}", parameters, options);
        }
    }
    #endregion Methods

}